---
import Base from '../layouts/Base.astro';
import { readFileSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import { dirname, join } from 'node:path';
import { parse } from 'yaml';

const __dirname = dirname(fileURLToPath(import.meta.url));
const root = join(__dirname, '..', '..');
const doc = parse(readFileSync(join(root, 'data', 'plans.yaml'), 'utf8'));

const PRICE_CAP = doc.meta.price_cap || 150;
const USD2CNY = 7.2;
const MAX_REFILL = 200000;
function cnyPrice(p) { return p.currency === 'usd' ? p.price_monthly * USD2CNY : p.price_monthly; }
function capaPts(p) { const r = p.capability_rank; return r === 1 ? 50 : r === 2 ? 25 : r === 3 ? 10 : r === 4 ? 5 : 0; }
function pricePts(p) { return Math.max(0, Math.min(50, 50 * (1 - cnyPrice(p) / 150))); }
function quotaPts(p) { return Math.min(50, ((p.refill_month ?? 0) / MAX_REFILL) * 50); }

const PROVIDER_MAP = [
  ['GLM','Z AI'],['DeepSeek','DeepSeek'],['Kimi','Kimi'],
  ['MiniMax','MiniMax'],['Qwen','Alibaba'],['MiMo','Xiaomi'],
  ['Doubao','ByteDance'],['ERNIE','Baidu'],['Hunyuan','Tencent'],['Pangu','Huawei'],
];
function modelProviders(models) {
  if (!models||!models.length) return new Set();
  const ps = new Set();
  for (const m of models) { for (const [prefix, name] of PROVIDER_MAP) { if (m.startsWith(prefix)) { ps.add(name); break; } } }
  return ps;
}
function calcBonus(p) {
  let pts = 0; const n = (p.models||[]).length;
  if (n >= 8) pts += 4; else if (n >= 6) pts += 3; else if (n >= 4) pts += 2; else if (n >= 2) pts += 1;
  if (p.purchase_difficulty === 'easy') pts += 2; else if (p.purchase_difficulty === 'normal') pts += 1;
  if (p.note && /首月/.test(p.note)) pts += 2;
  const pCount = modelProviders(p.models||[]).size;
  if (pCount >= 4) pts += 3; else if (pCount >= 3) pts += 2; else if (pCount >= 2) pts += 1;
  if (p.capability_rank === 1) pts += 3; else if (p.capability_rank === 2) pts += 2; else if (p.capability_rank === 3) pts += 1;
  if (p.region === 'cn') pts += 1;
  return Math.min(pts, 20);
}

const filtered = doc.plans.filter(p => cnyPrice(p) <= PRICE_CAP && [1,2,3,4].includes(p.capability_rank));
const featured = filtered.map(p => {
  const cp = capaPts(p), pp = pricePts(p), qp = quotaPts(p);
  const total = Math.min(100, cp * 0.80 + pp * 0.60 + qp * 0.60 + calcBonus(p));
  return { ...p, capa_pts: cp, price_pts: Number(pp.toFixed(2)), quota_pts: Number(qp.toFixed(2)), bonus_pts: calcBonus(p), total_score: Number(total.toFixed(2)) };
}).sort((a, b) => b.total_score - a.total_score).slice(0, 6);

const top = featured[0];
const meta = doc.meta;

function fmtPrice(p) { return p.currency === 'usd' ? `$${p.price_monthly}` : `¥${p.price_monthly}`; }
function fmtTokens(m) { if (!m) return '—'; return m >= 1000 ? `${(m / 1000).toFixed(2)}B` : `${m}M`; }
function fmtRefill(n) { if (!n) return '—'; return n >= 10000 ? `${(n / 10000).toFixed(1)}万` : n.toLocaleString(); }
const maxScore = featured[0]?.total_score ?? 10;
const minScore = featured[featured.length - 1]?.total_score ?? 0;
function barWidth(s) { return ((s - minScore) / Math.max(1e-9, maxScore - minScore)) * 100; }
function firstPrice(note) {
  const m = note.match(/首月[¥$]?([\d.]+)/);
  return m ? m[1] : null;
}
---

<Base path="/" title="AI 编程订阅 · 选最值的">
  <section class="wrap hero">
    <p class="eyebrow"><span class="bar"></span>AI 编程 · 怎么选最值</p>
    <h1>每月不超<span class="accent">¥{PRICE_CAP}</span>，<br/>模型就得用最强的。</h1>
    <p class="lede">从几十款套餐里筛出真正值得买的——价格不超¥{PRICE_CAP}、模型T0、用量扛造。不藏着掖着，怎么算的写在<a href="/method">方法页</a>里。</p>
    <p class="meta">更新于 {meta.updated} · {featured.length} 款过线</p>
  </section>

  <section class="wrap">
    <div class="answer">
      <div class="label">最值的一单</div>
      <div class="name">{top.platform} · {top.plan}</div>
      <p class="why">{top.note}</p>
      <div class="score-row">
        <div><div class="k">综合分</div><div class="v"><span class="accent">{top.total_score}</span><span style="color:var(--ink-faint)"> / 100</span></div></div>
        <div><div class="k">能力分</div><div class="v num">{top.capa_pts}</div></div>
        <div><div class="k">价格分</div><div class="v num">{top.price_pts}</div></div>
        <div><div class="k">用量分</div><div class="v num">{top.quota_pts}</div></div>
        {top.bonus_pts > 0 && <div><div class="k">体验加分</div><div class="v num" style="color:var(--accent)">+{top.bonus_pts}</div></div>}
      </div>
      <div style="margin-top:1.2rem">
        <a class="go-btn" href={top.affiliate_url || top.official_url} target="_blank" rel={top.affiliate_url ? 'noopener sponsored' : 'noopener nofollow'}>官方订阅 →</a>
      </div>
    </div>
  </section>

  <section class="wrap">
    <p class="eyebrow"><span class="bar"></span>过线排名 Top {featured.length}</p>
    <h2>预算以内，这几款值得看。</h2>
    <div class="cards">
      {featured.map((p, i) => (
        <article class="card">
          <div class="rank num">No. {String(i + 1).padStart(2, '0')}</div>
          <div class="platform">{p.platform}</div>
          <div class="plan"><a href={p.affiliate_url || p.official_url} target="_blank" rel={p.affiliate_url ? 'noopener sponsored' : 'noopener nofollow'}>{p.plan}</a></div>
          <div class="specs">
            <span class="k">旗舰模型</span><span class="v">{p.model_flagship}</span>
            <span class="k">月费</span><span class="v">{fmtPrice(p)}</span>
            {p.measured_monthly_tokens_M && <><span class="k">月可用 Token</span><span class="v">{fmtTokens(p.measured_monthly_tokens_M)}</span></>}
            {p.first_price && <><span class="k">首月</span><span class="v">{firstPrice(p.note)}</span></>}
            <span class="k">抢购</span><span class="v">{p.purchase_difficulty === 'easy' ? '无需' : p.purchase_difficulty === 'normal' ? '一般' : '需抢'}</span>
          </div>
          <p class="note">{p.note}</p>
          <div class="foot">
            <div class="score num"><span class="accent">{p.total_score}</span><span style="color:var(--ink-faint)"> / 100</span></div>
            <span class="verdict {p.verdict}">{p.verdict}</span>
          </div>
          <a class="goto" href={p.affiliate_url || p.official_url} target="_blank" rel={p.affiliate_url ? 'noopener sponsored' : 'noopener nofollow'}>官方订阅 →</a>
        </article>
      ))}
    </div>
  </section>

  <section class="wrap">
    <p class="eyebrow"><span class="bar"></span>综合分对比</p>
    <h2>谁最值，一眼看清。</h2>
    <div class="metric-bar">
      {featured.map(p => (
        <div class={`row ${p === top ? 'top' : ''}`}>
          <div class="label">{p.platform} · {p.plan}</div>
          <div class="track"><div class="fill" style={`width:${barWidth(p.total_score)}%`}></div></div>
          <div class="val num">{p.total_score}</div>
        </div>
      ))}
    </div>
    <p style="color:var(--ink-faint);font-size:.85rem;margin-top:1rem">
      综合分 = 能力×40% + 价格×30% + 用量×30%。不超过¥{PRICE_CAP}、模型≥国内前4。<a href="/method">方法说明 →</a>
    </p>
  </section>

  <section class="wrap" style="margin-top:4rem;padding-bottom:2rem">
    <p style="color:var(--ink-soft)"><b>不确定买哪个？</b> <a href="/calculator">用计算器，4 个问题给一个答案 →</a></p>
    <p style="color:var(--ink-soft);margin-top:.5rem">或者 <a href="/table">直接看 {doc.plans.length - featured.length} 款未过线的全套 →</a></p>
  </section>

  <section class="wrap" style="padding-bottom:2rem">
    <p class="eyebrow"><span class="bar"></span>模型能力排名</p>
    <h2>谁最强，一目了然。</h2>
    <p style="color:var(--ink-soft);max-width:62ch;margin-bottom:1.5rem">
      数据来自 <a href="https://artificialanalysis.ai/leaderboards/models" target="_blank" rel="noopener">Artificial Analysis</a> Intelligence Index，综合 9 项独立评测。前 10 名如下，<a href="/rankings">完整 25 名 →</a>
    </p>
    <div class="chart-home">
      {[
        { rank: 1, name: 'Claude Fable 5.1', org: 'Anthropic', score: 53, flag: '🇺🇸', note: 'max' },
        { rank: 2, name: 'GPT-6 Astra', org: 'OpenAI', score: 53, flag: '🇺🇸', note: 'max' },
        { rank: 3, name: 'Claude Opus 5', org: 'Anthropic', score: 51, flag: '🇺🇸', note: 'max' },
        { rank: 4, name: 'Muse Spark 1.3', org: 'Meta', score: 48, flag: '🇺🇸', note: 'max' },
        { rank: 5, name: 'GPT-5.6 Sol', org: 'OpenAI', score: 47, flag: '🇺🇸', note: 'max' },
        { rank: 6, name: 'Qwen3.8 Max', org: 'Alibaba', score: 45, flag: '🇨🇳', note: '0902 · 国内第1' },
        { rank: 7, name: 'GLM-5.3', org: 'Z AI', score: 45, flag: '🇨🇳', note: 'max · 国内第2' },
        { rank: 8, name: 'Grok 4.6', org: 'SpaceXAI', score: 44, flag: '🇺🇸', note: 'high' },
        { rank: 9, name: 'Step 5 Preview', org: 'StepFun', score: 44, flag: '🇨🇳', note: '阶跃星辰' },
        { rank: 10, name: 'Kimi K3', org: 'Kimi', score: 44, flag: '🇨🇳', note: 'max' },
      ].map(m => {
        const pct = (m.score / 53) * 100;
        const isCN = ['Z AI', 'Alibaba', 'MiniMax', 'DeepSeek', 'Kimi', 'Xiaomi', 'StepFun', 'Nex AGI'].includes(m.org);
        return (
          <div class="bar-row">
            <div class="bar-rank num">{m.rank}</div>
            <div class="bar-label">
              <span class="bar-name">{m.flag} {m.name}{m.note ? ` (${m.note})` : ''}</span>
              <span class="bar-org">{m.org}</span>
            </div>
            <div class="bar-track">
              <div class="bar-fill" style={`width:${pct}%`} data-cn={isCN ? '1' : '0'}></div>
            </div>
            <div class="bar-score num">{m.score}</div>
          </div>
        );
      })}
    </div>
    <div class="legend" style="margin-top:1rem;display:flex;gap:1.5rem;font-size:.82rem;color:var(--ink-soft)">
      <span><span style="display:inline-block;width:.8rem;height:.8rem;background:var(--accent);border-radius:2px;vertical-align:middle;margin-right:.3rem"></span>国内可订阅</span>
      <span><span style="display:inline-block;width:.8rem;height:.8rem;background:var(--ink-faint);border-radius:2px;vertical-align:middle;margin-right:.3rem"></span>海外为主</span>
    </div>
    <p style="color:var(--ink-faint);font-size:.82rem;margin-top:.8rem">
      评分截至 2026-09-21 · 来源：<a href="https://artificialanalysis.ai/leaderboards/models" target="_blank" rel="noopener">Artificial Analysis</a>
    </p>
  </section>

  <section class="wrap" style="padding-bottom:3rem">
    <p class="eyebrow"><span class="bar"></span>阶跃星辰 Step 5 Preview</p>
    <h2>6000 亿参数，追平 2.8 万亿的 K3。</h2>
    <p style="color:var(--ink-soft);max-width:62ch;margin-bottom:1.5rem">
      9/19 发布的 Step 5 Preview，AA 智能指数 44 分，与 Kimi K3 持平，Terminal-Bench 4.0 拿到 33.3%（接近 GPT-5.6 Terra）。Step Plan 走月池 Credit（1M Credit = ¥1），月内任意时段消耗，<b>没有 5 小时限额</b>——不存在写着写着被掐断的体验。
    </p>
    <div style="overflow-x:auto">
      <table class="thin-table">
        <thead>
          <tr>
            <th>档位</th>
            <th>月费</th>
            <th>月度 Credit</th>
            <th>5 小时限额</th>
            <th>备注</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><b>Flash Mini</b></td>
            <td class="num">¥49</td>
            <td class="num">400M</td>
            <td class="num">无</td>
            <td>入门够用，含全部旗舰模型</td>
          </tr>
          <tr>
            <td><b>Flash Plus</b></td>
            <td class="num">¥99</td>
            <td class="num">1600M</td>
            <td class="num">无</td>
            <td>加优先 API 速率 + 优先技术支持</td>
          </tr>
        </tbody>
      </table>
    </div>
    <p style="color:var(--ink-faint);font-size:.82rem;margin-top:1rem">
      另有 Pro ¥199/8000M、Max ¥699/40000M 两档（超个人预算上限）。新用户注册送 99 元套餐额度，完成首次调用再得 15 天，邀请好友累计最高 45 天。Step Plan 不适用按充值金额划分的阶梯限速。
    </p>
    <div style="margin-top:1.2rem">
      <a class="goto" href="https://platform.stepfun.com/docs/zh/step-plan/overview" target="_blank" rel="noopener nofollow">阶跃 Step Plan 官网 →</a>
    </div>
  </section>

  <section class="wrap" style="padding-bottom:3rem">
    <p class="eyebrow"><span class="bar"></span>便宜用量 · Top 3</p>
    <h2>量大又不追顶尖，这样最省。</h2>
    <p style="color:var(--ink-soft);max-width:62ch;margin-bottom:1.5rem">
      旗舰模型换代很快，但"够用 + 量大"的需求没变。按当前榜单（2026-09-21）重新排出的 3 条路：
    </p>
    <div class="top3">
      <div class="top3-card">
        <div class="rank num">No. 1</div>
        <div class="name">阿里·百炼 Token Plan Lite</div>
        <div class="price num">¥39/月</div>
        <p>Qwen3.8 Max 现在是<b>国内第 1</b>（全球 #17，45 分），和 GLM-5.3 同分。¥39 拿到国内最强模型 + 2500 Credits/周，综合分 76.7 居首。个人版低价档，Coding Plan Lite 已停售。</p>
        <a class="goto" href="https://www.aliyun.com/benefit/scene/tokenplan" target="_blank" rel="noopener">官方订阅 →</a>
      </div>
      <div class="top3-card">
        <div class="rank num">No. 2</div>
        <div class="name">OpenCode Go</div>
        <div class="price num">$10/月（≈¥72）</div>
